[Rewind]
; v2.1.2 syncs the maximum hold duration to rewind_user.wav.
; The supplied clip is 13.003 seconds, so defaults below are matched 1:1.
HistorySeconds=13.25
SnapshotHz=24
RewindSpeed=1.00
QuickRewindSeconds=3.0
MaxRewindSeconds=13.003

[World]
Radius=38.0
MaxEntities=32
TimeScale=0.12
RestoreHealth=0

[Anchor]
; Pose is intentionally disabled in v2.1.2 while the previous task-tree crash
; is being isolated. The one-hand pose will return through a safer path.
PoseAnim=IDLE_TAXI
PoseIFP=PED

[UI]
ButtonX=0.88
ButtonY=0.62
ButtonScale=1.0

[Effects]
Haptics=0

[Debug]
; Safe-start is hard-locked ON in v2.1.2.
SafeStart=1
