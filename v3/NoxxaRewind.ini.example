[Rewind]
; V3: exact gameplay cap. Keep the history slightly longer than the cap.
HistorySeconds=13.35
SnapshotHz=24
RewindSpeed=1.00
QuickRewindSeconds=3.0
MaxRewindSeconds=13.00

[World]
; Conservative defaults for Android stability and 120 Hz gameplay.
Radius=35.0
MaxEntities=28
TimeScale=0.10
RestoreHealth=0

[Anchor]
; IMPORTANT: the old animation task path was the only area correlated with the
; crash-on-press regression. V3 ships the safe one-shot gesture engine but keeps
; it OFF by default. Enable only after the core build is confirmed stable.
PoseEnabled=0
PoseAnim=IDLE_TAXI
PoseIFP=PED

[UI]
; compact top-left control
ButtonX=0.060
ButtonY=0.105
ButtonScale=0.88

[Effects]
Strength=1.00
Haptics=0

[Safety]
; Input is armed first; world/audio are activated on later game frames.
ArmFrames=2
RecoveryFrames=2
