+#include "RewindUI.hpp"
+
+#include <algorithm>
+#include <cstdio>
+
+#include <aml-psdk/game_sa/base/Timer.h>
+#include <aml-psdk/game_sa/engine/Font.h>
+#include <aml-psdk/game_sa/engine/RsGlobal.h>
+#include <aml-psdk/game_sa/engine/Sprite2d.h>
+
+namespace noxxa
+{
+bool RewindUI::Init(float xNorm, float yNorm, float scale)
+{
+    m_xNorm = std::max(0.05f, std::min(0.95f, xNorm));
+    m_yNorm = std::max(0.05f, std::min(0.95f, yNorm));
+    m_scale = std::max(0.55f, std::min(2.0f, scale));
+    return true;
+}
+
+void RewindUI::GetButtonRect(float& left, float& top, float& right, float& bottom) const
+{
+    const float w = static_cast<float>(RsGlobal.maximumWidth);
+    const float h = static_cast<float>(RsGlobal.maximumHeight);
+    const float size = h * 0.095f * m_scale;
+    const float cx = w * m_xNorm;
+    const float cy = h * m_yNorm;
+    left = cx - size * 0.5f;
+    right = cx + size * 0.5f;
+    top = cy - size * 0.5f;
+    bottom = cy + size * 0.5f;
+}
+
+bool RewindUI::HitTest(float x, float y, float extra) const
+{
+    float l, t, r, b;
+    GetButtonRect(l, t, r, b);
+    l -= extra; t -= extra; r += extra; b += extra;
+    return x >= l && x <= r && y >= t && y <= b;
+}
+
+void RewindUI::OnTouch(int actionType, int finger, int x, int y)
+{
+    // GTA Android/NVIDIA multitouch actions:
+    // 1 = UP, 2 = DOWN, 3 = MOVE, 4 = CANCEL.
+    if(actionType == 2)
+    {
+        if(HitTest(static_cast<float>(x), static_cast<float>(y)))
+        {
+            const unsigned int now = CTimer::GetTimeInMS();
+            if(m_lastTapMs != 0 && now - m_lastTapMs <= 320)
+                m_doubleTapPulse = true;
+            m_lastTapMs = now;
+            m_activeFinger = finger;
+            m_held = true;
+        }
+    }
+    else if(actionType == 3)
+    {
+        if(finger == m_activeFinger && m_held)
+        {
+            // Keep the hold forgiving if the thumb drifts a little.
+            float l, t, r, b;
+            GetButtonRect(l, t, r, b);
+            const float slop = static_cast<float>(RsGlobal.maximumHeight) * 0.06f;
+            if(!HitTest(static_cast<float>(x), static_cast<float>(y), slop))
+            {
+                m_held = false;
+                m_releasedPulse = true;
+                m_activeFinger = -1;
+            }
+        }
+    }
+    else if(actionType == 1 || actionType == 4)
+    {
+        if(finger == m_activeFinger)
+        {
+            if(m_held) m_releasedPulse = true;
+            m_held = false;
+            m_activeFinger = -1;
+        }
+    }
+}
+
+void RewindUI::PollInput(bool& held, bool& released, bool& doubleTapped)
+{
+    held = m_held;
+    released = m_releasedPulse;
+    doubleTapped = m_doubleTapPulse;
+    m_releasedPulse = false;
+    m_doubleTapPulse = false;
+}
+
+void RewindUI::DrawHud(bool rewinding, float rewoundSeconds, float historySeconds)
+{
+    float l, t, r, b;
+    GetButtonRect(l, t, r, b);
+
+    const float border = std::max(2.0f, static_cast<float>(RsGlobal.maximumHeight) * 0.004f);
+    CSprite2d::DrawRect(CRect(l - border, t - border, r + border, b + border),
+                        rewinding ? CRGBA(235, 235, 235, 230) : CRGBA(210, 210, 210, 180));
+    CSprite2d::DrawRect(CRect(l, t, r, b),
+                        rewinding ? CRGBA(32, 32, 38, 225) : CRGBA(15, 15, 20, 165));
+
+    const float cx = (l + r) * 0.5f;
+    const float cy = (t + b) * 0.5f;
+    const float fontScale = std::max(0.55f, (b - t) / 92.0f);
+
+    CFont::SetOrientation(ALIGN_CENTER);
+    CFont::SetColor(CRGBA(255, 255, 255, 255));
+    CFont::SetBackground(false, false);
+    CFont::SetProportional(true);
+    CFont::SetEdge(1);
+    CFont::SetDropColor(CRGBA(0, 0, 0, 220));
+    CFont::SetScale(fontScale);
+    CFont::SetWrapx(static_cast<float>(RsGlobal.maximumWidth));
+    CFont::SetFontStyle(FO_FONT_STYLE_HEADING);
+    CFont::PrintString(cx, cy - (b - t) * 0.18f, "<<");
+
+    if(rewinding)
+    {
+        char text[96];
+        snprintf(text, sizeof(text), "REWINDING  -%.1fs / %.1fs", rewoundSeconds, historySeconds);
+        CFont::SetScale(std::max(0.6f, static_cast<float>(RsGlobal.maximumHeight) / 900.0f));
+        CFont::SetFontStyle(FO_FONT_STYLE_STANDARD);
+        CFont::PrintString(static_cast<float>(RsGlobal.maximumWidth) * 0.5f,
+                           static_cast<float>(RsGlobal.maximumHeight) * 0.82f,
+                           text);
+    }
+
+    CFont::RenderFontBuffer();
+}
+}
